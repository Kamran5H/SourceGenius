# Copy this file to .env in the same directory and adjust as needed.
# Any variable left unset falls back to the default shown in the comment.

# Folder where scraped CSVs are written. Default: <your home dir>/Scrapped
SG_SAVE_FOLDER=

# How many keyword batches run in parallel. Higher = faster but more
# concurrent requests from this IP, which raises Amazon block risk.
# Default: 1
SG_CONCURRENCY=1

# Run Chrome headless (no visible window). Headless is more detectable to
# Amazon's bot checks than a real headed browser, so this defaults to false
# (headed). Set to "true" only if you understand the added block risk.
SG_HEADLESS=false

# Simulated shopper location — Amazon personalizes search/availability by
# region. These reproduce the original hardcoded NYC / ZIP-10003 profile.
SG_ZIP=10003
SG_LOCALE=en-US
SG_TIMEZONE=America/New_York
SG_LAT=40.7302
SG_LON=-73.9877
